{
  "name": "iron-log",
  "private": true,
  "version": "0.1.0",
  "description": "Offline iPhone home-screen app that runs the Retraining Protocol.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "npm run typecheck && vite build",
